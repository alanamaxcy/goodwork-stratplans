# Copy to .env and fill in the two values. `.env` is gitignored.
#
# Supabase -> Project Settings -> API. Both values are PUBLIC by design: the
# browser needs them to sign in, so they are compiled into the bundle. What
# keeps clients apart is row-level security, not the secrecy of these.
#
# The same two go on the Netlify site. Nothing else is needed to run, seed or
# deploy the portal.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# NOT here, and NOT in any .env file. SUPABASE_SERVICE_ROLE_KEY bypasses every
# rule in the database; it belongs only in Netlify's environment variables,
# where netlify/functions/team.mjs reads it server-side. Setup and seeding do
# not need it, and it must never carry a VITE_ prefix — that prefix is exactly
# what puts a value into the browser bundle.
